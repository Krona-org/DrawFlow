# Clangd Config for Qt6 MinGW 64-bit
CompileFlags:
  CompilationDatabase: "build-release"
  Add:
    - --target=x86_64-w64-mingw32
    - -std=c++17
    - -DMINGW_HAS_SECURE_API=1
    - -DQT_CORE_LIB
    - -DQT_GUI_LIB
    - -DQT_NO_DEBUG
    - -DQT_SVG_LIB
    - -DQT_WIDGETS_LIB
    - -DQT_XML_LIB
    - -DUNICODE
    - -DWIN32
    - -DWIN64
    - -D_ENABLE_EXTENDED_ALIGNED_STORAGE
    - -D_UNICODE
    - -D_WIN64
    - -DNDEBUG
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src/elements
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src/elements/common
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src/elements/shapeElement
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src/elements/connectorElement
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src/elements/masterBlockElement
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src/elements/maskElement
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src/frames
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src/widgets
    - -IC:/Users/marus/OneDrive/Desktop/editor_qt6/build-release/drawflow_autogen/include
    - -IC:/Users/marus/OneDrive/Desktop/editor_qt6
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include/QtCore
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include
    - -isystem
    - C:/Qt/6.10.2/mingw_64/mkspecs/win32-g++
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include/QtGui
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include/QtWidgets
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include/QtSvg
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include/QtXml
    - -isystem
    - C:/Qt/Tools/mingw1310_64/lib/gcc/x86_64-w64-mingw32/13.1.0/include/c++
    - -isystem
    - C:/Qt/Tools/mingw1310_64/lib/gcc/x86_64-w64-mingw32/13.1.0/include/c++/x86_64-w64-mingw32
    - -isystem
    - C:/Qt/Tools/mingw1310_64/lib/gcc/x86_64-w64-mingw32/13.1.0/include/c++/backward
    - -isystem
    - C:/Qt/Tools/mingw1310_64/lib/gcc/x86_64-w64-mingw32/13.1.0/include
    - -isystem
    - C:/Qt/Tools/mingw1310_64/lib/gcc/x86_64-w64-mingw32/13.1.0/include-fixed
    - -isystem
    - C:/Qt/Tools/mingw1310_64/x86_64-w64-mingw32/include
    - -Wno-unknown-warning-option
    - -Wno-unused-command-line-argument
    - -Wno-attributes
  Remove:
    - -fno-keep-inline-dllexport
    - -mno-direct-extern-access
    - "-fconcepts-diagnostics-depth=*"
    - -fmodules-ts
    - "-fmodule-mapper=*"
    - "-fdeps-format=*"
    - "-fdeps-file=*"
    - "-fdeps-target=*"
Documentation:
  CommentFormat: Doxygen
