# Сгенерировано Clangd Config Assistant: Qt6: Core, Gui, Svg, Widgets, Xml | compile_commands.json: build-release | g++.exe (x86_64-w64-mingw32) | C++17
CompileFlags:
  CompilationDatabase: "build-release"
  Compiler: "C:/Qt/Tools/mingw1310_64/bin/g++.exe"
  Add:
    - --target=x86_64-w64-mingw32
