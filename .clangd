    - -DQT_WIDGETS_LIB
    - -DQT_XML_LIB
    - -DUNICODE
    - -DWIN32
    - -DWIN64
    - -D_ENABLE_EXTENDED_ALIGNED_STORAGE
    - -D_UNICODE
    - -D_WIN64
    - -DNDEBUG
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6
    - -Ic:/Users/marus/OneDrive/Desktop/editor_qt6/src
    - -IC:/Users/marus/OneDrive/Desktop/editor_qt6/build-release/drawflow_autogen/include
    - -IC:/Users/marus/OneDrive/Desktop/editor_qt6
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include/QtCore
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include
    - -isystem
    - C:/Qt/6.10.2/mingw_64/mkspecs/win32-g++
    - -isystem
    - C:/Qt/6.10.2/mingw_64/include/QtGui
    - -isystem
